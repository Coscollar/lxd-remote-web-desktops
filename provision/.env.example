# Proveedor SMTP (dev=mailtrap, prod=real)
SMTP_PROVIDER=mailtrap
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASS=

# JWT navegador (HS256). JWT_SECRET_PREV permite rotación sin invalidar sesiones.
JWT_SECRET=
JWT_SECRET_PREV=
JWT_TTL=3600
JWT_ISS=provision-api
JWT_AUD=lab-gateway

# Service token de VM (secreto SEPARADO del navegador)
SERVICE_JWT_SECRET=
SERVICE_JWT_TTL=86400

# Dominio público y URLs internas
PUBLIC_DOMAIN=lab.example.com
PROVISION_URL=http://127.0.0.1:8000
PROVISION_URL_VM=http://10.50.20.1:8000

# Magic link
MAGIC_LINK_TTL=900
MAGIC_LINK_LEN=32

# Rate-limit (slowapi)
RL_PER_IP=5/minute
RL_PER_EMAIL=3/10minutes
RL_GLOBAL=60/minute

# DB
DB_PATH=provision.db

# --- Policy engine (FASE 5) ---
# Inactividad: minutos sin heartbeat/actividad RDP antes de destruir.
IDLE_MINUTES=60
# Fecha límite del curso (YYYY-MM-DD). Vacío = sin deadline global.
COURSE_DEADLINE=
# Retención de snapshots k1..kN por instancia (FIFO). Pool guard puede reducirlo.
KEEP_SNAPSHOTS=5
# Segundos máximos en estado 'creando' antes de que el reaper la marque estancada.
CREATING_TIMEOUT=600

# --- FASE 6: Admin + defensa en profundidad ---
# Token para automatización API (curl/systemd). Solo API, no navegador.
ADMIN_TOKEN=
# Header secreto compartido Nginx→provision-api (defensa en profundidad).
INTERNAL_TOKEN=
# JWT admin (HS256, secreto SEPARADO del navegador). _PREV permite rotación.
ADMIN_JWT_SECRET=
ADMIN_JWT_SECRET_PREV=
ADMIN_JWT_TTL=1800
ADMIN_JWT_AUD=lab-admin
ADMIN_MAGIC_LINK_TTL=300
ADMIN_TOTP_REQUIRED=0
ADMIN_TOTP_KEY=
ADMIN_IP_BINDING=0

# --- FASE 6: Apps stateless ---
# Inactividad app per-alumno (minutos) antes de destruir.
APP_IDLE_MINUTES=30
# Inactividad app shared no-always_on (horas) antes de destruir.
SHARED_IDLE_HOURS=6
# Segundos máximos en estado 'creando' para apps (worker_heartbeat es primario).
APP_CREATING_TIMEOUT=300
# Grace period tras reinicio de provision-api (segundos) antes de reapear apps.
GRACE_AFTER_RESTART=900
# Hard cap de instancias de apps concurrentes (pool-wide).
MAX_APP_INSTANCES=40
# Budget máximo de RAM para apps shared always_on=1 (MB).
ALWAYS_ON_BUDGET_MB=8192
# Semáforo de lanzamientos concurrentes de apps.
APP_LAUNCH_SEM=6
# URL que usan las apps para heartbeat (IP del host en bridge lab-stateless).
PROVISION_URL_APP=http://10.50.10.1:8000